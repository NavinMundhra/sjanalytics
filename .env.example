# OpenRouter API Configuration (optional if using direct Google API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model to use via OpenRouter (default: google/gemini-pro-1.5)
# Other options: google/gemini-pro, openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=google/gemini-pro-1.5

# Google Gemini API Configuration (fallback/alternative to OpenRouter)
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Model to use for direct Google API (default: gemini-1.5-flash)
# Other options: gemini-1.5-pro, gemini-pro
GOOGLE_MODEL=gemini-1.5-flash

# Gupshup WhatsApp Configuration
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_APP_NAME=your_gupshup_app_name
GUPSHUP_SOURCE_NUMBER=your_whatsapp_business_number

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# Server Configuration (optional, defaults to 8000)
PORT=8000
