# OpenRouter API Configuration (PRIMARY - uses GPT-4o-mini for better accuracy)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model to use via OpenRouter (default: openai/gpt-4o-mini for best accuracy)
# Other options: google/gemini-2.0-flash-001, anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini API Configuration (FALLBACK when OpenRouter fails)
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Model to use for direct Google API (default: gemini-2.0-flash)
# NOTE: Gemini 1.5 models are RETIRED as of April 2025
# Other options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash-lite
GOOGLE_MODEL=gemini-2.0-flash

# Gupshup WhatsApp Configuration
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_APP_NAME=your_gupshup_app_name
GUPSHUP_SOURCE_NUMBER=your_whatsapp_business_number

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# Data Source Configuration
# Only this CSV file will be used for analysis (for better accuracy)
PRIMARY_DATA_FILE=monthly_master/master.csv

# Server Configuration (optional, defaults to 8000)
PORT=8000
